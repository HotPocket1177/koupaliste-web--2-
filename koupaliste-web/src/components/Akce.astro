---
import { site } from '../data/site.js';

// Zobraz jen akce, které ještě neproběhly (dnešek včetně), seřazené od nejbližší.
const dnes = new Date();
dnes.setHours(0, 0, 0, 0);

const mesice = ['ledna','února','března','dubna','května','června','července','srpna','září','října','listopadu','prosince'];
function formatDatum(iso) {
  const [r, m, d] = iso.split('-').map(Number);
  return `${d}. ${mesice[m - 1]} ${r}`;
}

const nadchazejici = (site.akce ?? [])
  .filter((a) => new Date(a.datum + 'T23:59:59') >= dnes)
  .sort((a, b) => a.datum.localeCompare(b.datum));

const probehle = (site.akce ?? [])
  .filter((a) => new Date(a.datum + 'T23:59:59') < dnes)
  .sort((a, b) => b.datum.localeCompare(a.datum));
---
{(nadchazejici.length > 0 || site.akcePravidelne) && (
  <section id="akce" class="section section-cream">
    <div class="container">
      <p class="eyebrow">Co nás čeká</p>
      <h2>Akce u koupaliště</h2>

      {site.akcePravidelne && (
        site.akcePravidelne.banner ? (
          <details class="akce-card akce-card-pravidelne akce-card-plakat">
            <summary>
              <div class="akce-date akce-date-pravidelne" aria-hidden="true">
                <span class="akce-tag">Pravidelně</span>
              </div>
              <div class="akce-body">
                <h3>
                  Sobotní ranní cvičení
                  <span class="akce-plakat-badge">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="10" r="1.5"/><path d="M3 16l5-4 4 3 3-2 6 5"/></svg>
                    Plakát
                  </span>
                </h3>
                <p class="akce-popis">{site.akcePravidelne.text}</p>
              </div>
              <div class="akce-chevron" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
              </div>
            </summary>
            <div class="akce-poster-wrap">
              <button type="button" class="akce-poster-btn" data-src={site.akcePravidelne.banner} data-alt="Plakát — Sobotní ráno na koupališti">
                <img class="akce-poster" src={site.akcePravidelne.banner} alt="Plakát — Sobotní ráno na koupališti" loading="lazy" />
              </button>
            </div>
          </details>
        ) : (
          <article class="akce-card akce-card-pravidelne">
            <div class="akce-date akce-date-pravidelne" aria-hidden="true">
              <span class="akce-tag">Pravidelně</span>
            </div>
            <div class="akce-body">
              <h3>Sobotní ranní cvičení</h3>
              <p class="akce-popis">{site.akcePravidelne.text}</p>
            </div>
          </article>
        )
      )}

      <div class="akce-list">
        {nadchazejici.map((a) => {
          const [r, m, d] = a.datum.split('-').map(Number);
          const hlava = (
            <>
              <div class="akce-date" aria-hidden="true">
                <span class="akce-den">{d}</span>
                <span class="akce-mesic">{mesice[m - 1].slice(0, 3)}</span>
              </div>
              <div class="akce-body">
                <h3>
                  {a.nazev}
                  {a.banner && (
                    <span class="akce-plakat-badge">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="10" r="1.5"/><path d="M3 16l5-4 4 3 3-2 6 5"/></svg>
                      Plakát
                    </span>
                  )}
                </h3>
                <p class="akce-meta">
                  <time datetime={a.datum}>{formatDatum(a.datum)}</time>
                  {a.cas && <span class="akce-cas"> · {a.cas}</span>}
                </p>
                <p class="akce-popis">{a.popis}</p>
                {a.fbUrl && (
                  <a class="akce-fb" href={a.fbUrl} target="_blank" rel="noopener">
                    Událost na Facebooku →
                  </a>
                )}
              </div>
            </>
          );
          return a.banner ? (
            <details class="akce-card akce-card-plakat">
              <summary>
                {hlava}
                <div class="akce-chevron" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
                </div>
              </summary>
              <div class="akce-poster-wrap">
                <button type="button" class="akce-poster-btn" data-src={a.banner} data-alt={`Plakát — ${a.nazev}`}>
                  <img class="akce-poster" src={a.banner} alt={`Plakát — ${a.nazev}`} loading="lazy" />
                </button>
              </div>
            </details>
          ) : (
            <article class="akce-card">{hlava}</article>
          );
        })}
      </div>

      {probehle.length > 0 && (
        <details class="akce-archiv">
          <summary>Proběhlé akce ({probehle.length})</summary>
          <div class="akce-list">
            {probehle.map((a) => {
              const [r, m, d] = a.datum.split('-').map(Number);
              return (
                <article class="akce-card">
                  <div class="akce-date" aria-hidden="true">
                    <span class="akce-den">{d}</span>
                    <span class="akce-mesic">{mesice[m - 1].slice(0, 3)}</span>
                  </div>
                  <div class="akce-body">
                    <h3>{a.nazev}</h3>
                    <p class="akce-meta">
                      <time datetime={a.datum}>{formatDatum(a.datum)}</time>
                      {a.cas && <span class="akce-cas"> · {a.cas}</span>}
                    </p>
                    <p class="akce-popis">{a.popis}</p>
                    {a.fbUrl && (
                      <a class="akce-fb" href={a.fbUrl} target="_blank" rel="noopener">
                        Událost na Facebooku →
                      </a>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        </details>
      )}
    </div>

    <dialog id="poster-lightbox" class="poster-lightbox">
      <button type="button" class="poster-lightbox-zavrit" id="poster-lightbox-zavrit" aria-label="Zavřít plakát">×</button>
      <div class="poster-lightbox-scroll" id="poster-lightbox-scroll">
        <img id="poster-lightbox-img" src="" alt="" />
      </div>
      <p class="poster-lightbox-hint">Klikni na plakát pro přiblížení</p>
    </dialog>

    <script>
      const lightbox = document.getElementById('poster-lightbox');
      const lightboxImg = document.getElementById('poster-lightbox-img');
      const lightboxScroll = document.getElementById('poster-lightbox-scroll');
      const lightboxClose = document.getElementById('poster-lightbox-zavrit');

      document.querySelectorAll('.akce-poster-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (!(lightboxImg instanceof HTMLImageElement)) return;
          lightboxImg.src = btn.getAttribute('data-src') ?? '';
          lightboxImg.alt = btn.getAttribute('data-alt') ?? '';
          lightboxImg.classList.remove('zoomed');
          if (lightbox instanceof HTMLDialogElement) lightbox.showModal();
        });
      });

      lightboxClose?.addEventListener('click', () => {
        if (lightbox instanceof HTMLDialogElement) lightbox.close();
      });
      lightbox?.addEventListener('click', (e) => {
        if (e.target === lightbox && lightbox instanceof HTMLDialogElement) lightbox.close();
      });
      lightboxImg?.addEventListener('click', () => lightboxImg.classList.toggle('zoomed'));
      lightbox?.addEventListener('close', () => {
        lightboxScroll?.scrollTo(0, 0);
        lightboxImg?.classList.remove('zoomed');
      });
    </script>

    <style>
      .akce-list { display: flex; flex-direction: column; gap: 1rem; margin-top: 1.4rem; }
      .akce-card {
        display: flex; gap: 1.2rem; align-items: stretch;
        background: #fff; border-radius: var(--radius); box-shadow: var(--shadow);
        overflow: hidden;
      }
      details.akce-card { display: block; }
      details.akce-card > summary {
        display: flex; gap: 1.2rem; align-items: stretch; cursor: pointer; list-style: none;
      }
      details.akce-card > summary::-webkit-details-marker { display: none; }
      .akce-plakat-badge {
        display: inline-flex; align-items: center; gap: 0.3rem; vertical-align: middle;
        font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.05em;
        font-size: 0.62rem; font-weight: 600; color: var(--navy);
        background: var(--water); padding: 0.15rem 0.5rem 0.15rem 0.4rem; border-radius: 100px;
      }
      .akce-plakat-badge svg { width: 11px; height: 11px; }
      .akce-chevron {
        flex: 0 0 auto; align-self: center; margin-right: 1.2rem;
        width: 26px; height: 26px; border-radius: 50%;
        background: var(--cream); display: flex; align-items: center; justify-content: center;
        color: var(--navy); transition: transform 0.2s ease;
      }
      details[open] > summary .akce-chevron { transform: rotate(180deg); }
      .akce-poster-wrap { padding: 0.7rem 1.2rem 1.3rem; }
      .akce-poster-btn {
        display: block; max-width: 240px; width: 100%; padding: 0; border: none;
        background: none; cursor: zoom-in; border-radius: 4px;
      }
      .akce-poster {
        display: block; width: 100%; border-radius: 4px;
        box-shadow: 0 6px 20px rgba(20, 35, 61, 0.2);
      }

      .poster-lightbox {
        border: none; padding: 0; margin: auto; background: transparent;
        width: 100vw; height: 100vh; max-width: 100vw; max-height: 100vh;
      }
      .poster-lightbox::backdrop { background: rgba(10, 16, 28, 0.94); }
      .poster-lightbox-scroll {
        width: 100vw; height: 100vh; overflow: auto; overscroll-behavior: contain;
        display: flex; align-items: center; justify-content: center;
        touch-action: pinch-zoom pan-x pan-y;
      }
      #poster-lightbox-img { max-width: 92vw; max-height: 92vh; display: block; cursor: zoom-in; }
      #poster-lightbox-img.zoomed {
        max-width: none; max-height: none; width: 200%; cursor: zoom-out;
      }
      .poster-lightbox-zavrit {
        position: fixed; top: 1rem; right: 1rem; z-index: 2;
        width: 42px; height: 42px; border-radius: 50%; border: none;
        background: var(--red); color: #fff; font-size: 1.5rem; line-height: 1;
        display: flex; align-items: center; justify-content: center; cursor: pointer;
      }
      .poster-lightbox-zavrit:hover { background: var(--red-dark); }
      .poster-lightbox-hint {
        position: fixed; bottom: 1rem; left: 50%; transform: translateX(-50%);
        color: var(--cream); font-family: var(--font-display); text-transform: uppercase;
        letter-spacing: 0.05em; font-size: 0.75rem; opacity: 0.7; margin: 0; pointer-events: none;
      }
      @media (max-width: 560px) {
        .poster-lightbox-hint { display: none; }
      }
      .akce-date {
        flex: 0 0 84px; display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        background: var(--navy); color: var(--cream); padding: 0.9rem 0.5rem;
      }
      .akce-den { font-family: var(--font-display); font-size: 2rem; font-weight: 700; line-height: 1; }
      .akce-mesic {
        font-family: var(--font-display); text-transform: uppercase;
        letter-spacing: 0.1em; font-size: 0.8rem; color: var(--water);
      }
      .akce-body { padding: 1rem 1.2rem 1.1rem 0; }
      .akce-body h3 { color: var(--navy); margin-bottom: 0.15rem; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
      .akce-meta { font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.04em; font-size: 0.82rem; color: var(--red); margin-bottom: 0.5rem; }
      .akce-cas { color: var(--red); }
      .akce-popis { margin: 0 0 0.6rem; color: #33405c; }
      .akce-fb {
        font-family: var(--font-display); text-transform: uppercase;
        letter-spacing: 0.05em; font-size: 0.85rem; font-weight: 600; color: var(--red);
      }
      .akce-card-pravidelne { margin-top: 1.4rem; }
      .akce-date-pravidelne { background: var(--red); }
      .akce-tag {
        font-family: var(--font-display); text-transform: uppercase;
        letter-spacing: 0.05em; font-size: 0.72rem; font-weight: 600;
        color: #fff; text-align: center;
      }
      .akce-archiv { margin-top: 1.6rem; }
      .akce-archiv summary {
        cursor: pointer; font-family: var(--font-display); text-transform: uppercase;
        letter-spacing: 0.05em; font-size: 0.85rem; font-weight: 600; color: var(--navy);
      }
      .akce-archiv .akce-list { margin-top: 1rem; }
      .akce-archiv .akce-card { opacity: 0.75; }
      @media (max-width: 560px) {
        .akce-card { flex-direction: column; }
        .akce-date { flex-direction: row; gap: 0.5rem; justify-content: flex-start; padding: 0.6rem 1.2rem; }
        .akce-den { font-size: 1.4rem; }
        .akce-body { padding: 0.9rem 1.2rem 1.1rem; }
      }
    </style>
  </section>
)}
