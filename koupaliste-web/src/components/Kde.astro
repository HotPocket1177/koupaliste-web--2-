---
import { site } from '../data/site.js';
const { kontakt } = site;
---
<section id="kde" class="section section-sand">
  <div class="container kde-grid">
    <div>
      <p class="eyebrow">Kde nás najdete</p>
      <h2>U koupaliště<br />v Teplicích</h2>
      <address class="kde-adresa">
        {kontakt.adresaRadky.map((r) => (<span>{r}<br /></span>))}
      </address>
      <p class="kde-kontakt">
        <a href={kontakt.telefonHref} class="btn btn-navy">Zavolat {kontakt.telefon}</a>
      </p>
      <p>
        <a href={kontakt.mapaUrl} target="_blank" rel="noopener">Otevřít v Mapách →</a><br />
        <a href={`mailto:${kontakt.email}`}>{kontakt.email}</a>
      </p>
    </div>
    <div class="kde-map">
      <iframe
        title="Mapa — Kiosek koupaliště, Teplice nad Metují"
        src="https://mapy.com/s/lonesehapa?frame=1"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
      <p class="map-fallback"><a href={kontakt.mapaUrl} target="_blank" rel="noopener">Zobrazit trasu na Mapy.com</a></p>
    </div>
  </div>
  <style>
    .kde-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 2.4rem; align-items: center; }
    .kde-adresa { font-style: normal; font-size: 1.1rem; margin-bottom: 1.2rem; }
    .kde-kontakt { margin-bottom: 1rem; }
    .kde-map iframe { width: 100%; height: 340px; border: 3px solid var(--navy); border-radius: var(--radius); box-shadow: var(--shadow); }
    .map-fallback { margin-top: 0.5rem; font-size: 0.9rem; }
    @media (max-width: 760px) { .kde-grid { grid-template-columns: 1fr; gap: 1.6rem; } .kde-map iframe { height: 280px; } }
  </style>
</section>
