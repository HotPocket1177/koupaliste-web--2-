---
import { site } from '../data/site.js';
---
<section id="nabidka" class="section section-navy">
  <div class="container">
    <p class="eyebrow">Co u nás dostanete</p>
    <h2>Nabídka</h2>
    <div class="nabidka-grid">
      {site.nabidka.map((item) => (
        <article class="nab-card">
          <h3>{item.nadpis}</h3>
          {item.znacka && <span class="nab-znacka">{item.znacka}</span>}
          <p>{item.popis}</p>
        </article>
      ))}
    </div>
    <div class="vybaveni">
      {site.vybaveni.map((v) => (<span class="chip">{v}</span>))}
    </div>
  </div>
  <style>
    .nabidka-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.2rem; margin-top: 1.4rem; }
    .nab-card { background: rgba(245, 236, 216, 0.06); border: 1px solid rgba(245, 236, 216, 0.16); border-radius: var(--radius); padding: 1.4rem 1.3rem; }
    .nab-card h3 { color: #fff; margin-bottom: 0.3rem; }
    .nab-znacka { display: inline-block; font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.72rem; color: var(--navy); background: var(--water); padding: 0.15rem 0.55rem; border-radius: 2px; margin-bottom: 0.6rem; }
    .nab-card p { color: var(--water-pale); margin: 0.4rem 0 0; }
    .vybaveni { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 2rem; }
    .chip { font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.04em; font-size: 0.78rem; font-weight: 500; color: var(--cream); border: 1px solid rgba(245,236,216,0.28); padding: 0.3rem 0.75rem; border-radius: 100px; }
  </style>
</section>
