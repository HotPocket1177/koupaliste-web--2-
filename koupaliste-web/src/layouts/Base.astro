---
import '../styles/global.css';
import { site } from '../data/site.js';

const { title, description } = Astro.props;
const pageTitle = title ? `${title} — ${site.nazev}` : `${site.nazev} — ${site.podtitul}`;
const desc = description ?? `${site.nazev} v ${site.podtitul}. ${site.slogan} Výběrová káva, čepované pivo, nanuky a osvěžení u vody.`;

// Odkaz "Akce" v menu ukážeme jen když je aspoň jedna nadcházející akce.
const dnesMenu = new Date(); dnesMenu.setHours(0,0,0,0);
const maAkce = (site.akce ?? []).some((a) => new Date(a.datum + 'T23:59:59') >= dnesMenu);
---
<!doctype html>
<html lang="cs">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={desc} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="/og.jpg" />
  <meta name="theme-color" content="#1b2f52" />
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand" aria-label={`${site.nazev} — domů`}>
        <img src="/logo.png" alt="" width="52" height="52" />
        <span class="brand-text">
          <strong>{site.nazev}</strong>
          <small>{site.podtitul} · od {site.odRoku}</small>
        </span>
      </a>
      <div class="header-actions">
        <nav class="nav" aria-label="Hlavní navigace">
          <a href="/#nabidka">Nabídka</a>
          {maAkce && <a href="/#akce">Akce</a>}
          <a href="/#otevreno">Otevírací doba</a>
          <a href="/#kde">Kde nás najdete</a>
          <button type="button" class="nav-legal pravni-otevrit">Právní informace</button>
        </nav>
        <a href={site.kontakt.telefonHref} class="nav-cta">{site.kontakt.telefon}</a>
        <button type="button" class="burger" id="burger-toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label="Otevřít menu">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>

    <nav class="mobile-menu" id="mobile-menu" aria-label="Mobilní navigace">
      <ul>
        <li><a href="/#nabidka">Nabídka</a></li>
        {maAkce && <li><a href="/#akce">Akce</a></li>}
        <li><a href="/#otevreno">Otevírací doba</a></li>
        <li><a href="/#kde">Kde nás najdete</a></li>
        <li><button type="button" class="menu-link pravni-otevrit">Právní informace</button></li>
      </ul>
    </nav>
  </header>

  <dialog id="pravni-dialog" class="pravni-dialog" aria-labelledby="pravni-nadpis">
    <button type="button" class="pravni-zavrit" id="pravni-zavrit" aria-label="Zavřít právní informace">×</button>
    <div class="pravni-obsah">
      <h2 id="pravni-nadpis">Právní informace</h2>

      <h3>Provozovatel</h3>
      <p>
        {site.pravni.provozovatel.jmeno}<br />
        IČO: {site.pravni.provozovatel.ico}<br />
        Sídlo: {site.pravni.provozovatel.sidlo}
      </p>
      <p>{site.pravni.provozovatel.poznamka}</p>

      <h3>Provozovna</h3>
      <p>
        {site.pravni.provozovna.nazev}<br />
        {site.pravni.provozovna.adresaRadky.map((r) => (<span>{r}<br /></span>))}
        Identifikační číslo provozovny: {site.pravni.provozovna.idProvozovny}
      </p>
      <p>{site.pravni.provozovna.poznamka}</p>
      {site.pravni.provozovna.vypisUrl && (
        <p><a href={site.pravni.provozovna.vypisUrl} target="_blank" rel="noopener">Výpis z živnostenského rejstříku (PDF) →</a></p>
      )}

      <h3>Mimosoudní řešení spotřebitelských sporů</h3>
      <p>{site.pravni.mimosoudniUvod}</p>
      <p>
        {site.pravni.coi.nazev}<br />
        {site.pravni.coi.oddeleni}<br />
        {site.pravni.coi.adresaRadky.map((r) => (<span>{r}<br /></span>))}
        E-mail: <a href={`mailto:${site.pravni.coi.email}`}>{site.pravni.coi.email}</a><br />
        {site.pravni.coi.url && (
          <a href={site.pravni.coi.url} target="_blank" rel="noopener">Mimosoudní řešení spotřebitelských sporů – ČOI →</a>
        )}
      </p>

      <h3>Ochrana soukromí</h3>
      <p>{site.pravni.ochranaSoukromi}</p>
    </div>
  </dialog>

  <script>
    const dialog = document.getElementById('pravni-dialog');
    const zavritBtn = document.getElementById('pravni-zavrit');

    document.querySelectorAll('.pravni-otevrit').forEach((btn) => {
      btn.addEventListener('click', () => dialog?.showModal());
    });
    zavritBtn?.addEventListener('click', () => dialog?.close());
    dialog?.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    const burger = document.getElementById('burger-toggle');
    const mobileMenu = document.getElementById('mobile-menu');

    burger?.addEventListener('click', () => {
      const open = mobileMenu?.classList.toggle('open');
      burger.setAttribute('aria-expanded', String(!!open));
      burger.setAttribute('aria-label', open ? 'Zavřít menu' : 'Otevřít menu');
    });
    mobileMenu?.querySelectorAll('a, button.menu-link').forEach((el) => {
      el.addEventListener('click', () => {
        mobileMenu.classList.remove('open');
        burger?.setAttribute('aria-expanded', 'false');
        burger?.setAttribute('aria-label', 'Otevřít menu');
      });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        mobileMenu?.classList.remove('open');
        burger?.setAttribute('aria-expanded', 'false');
        burger?.setAttribute('aria-label', 'Otevřít menu');
      }
    });
  </script>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container footer-grid">
      <div>
        <div class="footer-brand">
          <img src="/logo.png" alt="" width="46" height="46" />
          <span><strong>{site.nazev}</strong><br /><small>od {site.odRoku}</small></span>
        </div>
        <p class="footer-slogan">{site.slogan}</p>
      </div>
      <div>
        <h4>Kontakt</h4>
        <p>
          <a href={site.kontakt.telefonHref}>{site.kontakt.telefon}</a><br />
          <a href={`mailto:${site.kontakt.email}`}>{site.kontakt.email}</a>
        </p>
        <p>{site.kontakt.adresaRadky.map((r) => (<span>{r}<br /></span>))}</p>
      </div>
      <div>
        <h4>Sledujte nás</h4>
        <p class="footer-links">
          <a href={site.site.facebook} target="_blank" rel="noopener">Facebook</a>
          <a href={site.site.instagram} target="_blank" rel="noopener">Instagram</a>
          <a href={site.site.firmy} target="_blank" rel="noopener">Firmy.cz</a>
        </p>
      </div>
    </div>
    <div class="container footer-bottom">
      <span>© {new Date().getFullYear()} {site.nazev} · Teplice nad Metují</span>
    </div>
  </footer>

  <style>
    .site-header {
      position: sticky; top: 0; z-index: 50; background: rgba(27, 47, 82, 0.96);
      backdrop-filter: blur(6px); border-bottom: 3px solid var(--red);
    }
    .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 0.6rem; }
    .brand { display: flex; align-items: center; gap: 0.7rem; text-decoration: none; }
    .brand img { border-radius: 50%; background: var(--cream); }
    .brand-text { display: flex; flex-direction: column; line-height: 1.1; }
    .brand-text strong { font-family: var(--font-display); text-transform: uppercase; color: #fff; font-size: 1.05rem; letter-spacing: 0.03em; font-weight: 600; }
    .brand-text small { color: var(--water); font-size: 0.72rem; letter-spacing: 0.05em; }
    .header-actions { display: flex; align-items: center; gap: 1rem; }
    .nav { display: flex; align-items: center; gap: 1.4rem; }
    .nav a { color: var(--cream); font-family: var(--font-display); text-transform: uppercase; font-size: 0.9rem; letter-spacing: 0.05em; font-weight: 500; text-decoration: none; }
    .nav a:hover { color: #fff; text-decoration: underline; text-underline-offset: 4px; }
    .nav-cta { background: var(--red); padding: 0.4rem 0.9rem; border-radius: var(--radius); color: #fff !important; white-space: nowrap; }
    .nav-cta:hover { background: var(--red-dark); text-decoration: none !important; }
    .nav-legal {
      background: transparent; border: 1px solid rgba(245, 236, 216, 0.5); border-radius: var(--radius);
      color: var(--cream); font-family: var(--font-display); text-transform: uppercase;
      font-size: 0.78rem; letter-spacing: 0.04em; font-weight: 500; padding: 0.35rem 0.7rem;
      cursor: pointer; white-space: nowrap;
    }
    .nav-legal:hover { background: var(--cream); color: var(--navy); border-color: var(--cream); }

    .burger {
      display: none; width: 36px; height: 36px; border-radius: var(--radius);
      border: 1px solid rgba(245, 236, 216, 0.4); background: transparent;
      flex-direction: column; align-items: center; justify-content: center;
      gap: 4px; cursor: pointer; padding: 0; flex: none;
    }
    .burger span { width: 17px; height: 2px; background: var(--cream); border-radius: 2px; transition: transform 0.25s ease, opacity 0.2s ease; }
    .burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
    .burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
    .burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

    .mobile-menu {
      display: none; position: absolute; top: 100%; left: 0; right: 0;
      background: var(--navy-deep); overflow: hidden; max-height: 0;
      transition: max-height 0.28s ease;
    }
    .mobile-menu ul { list-style: none; margin: 0; padding: 0.4rem 0; }
    .mobile-menu a, .mobile-menu button.menu-link {
      display: block; width: 100%; text-align: left; background: none; border: none;
      font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.03em;
      font-size: 0.95rem; font-weight: 500; color: var(--cream); text-decoration: none;
      padding: 0.9rem 1.25rem; border-top: 1px solid rgba(245, 236, 216, 0.08); cursor: pointer;
    }
    .mobile-menu li:first-child a { border-top: none; }

    @media (max-width: 760px) {
      .nav { display: none; }
      .nav-cta { font-size: 0.78rem; padding: 0.35rem 0.6rem; letter-spacing: 0.02em; }
      .burger { display: flex; }
      .mobile-menu { display: block; }
      .mobile-menu.open { max-height: 400px; }
    }
    @media (max-width: 400px) {
      .nav-cta { font-size: 0.7rem; padding: 0.3rem 0.5rem; }
    }

    .pravni-dialog {
      border: none; border-radius: 8px; padding: 0; margin: auto;
      width: min(94vw, 640px); max-height: min(85vh, 720px);
      background: var(--paper); color: var(--ink);
    }
    .pravni-dialog::backdrop { background: rgba(20, 35, 61, 0.6); backdrop-filter: blur(2px); }
    .pravni-obsah { padding: 2.4rem 1.6rem 2rem; overflow-y: auto; max-height: min(85vh, 720px); }
    .pravni-obsah h2 { color: var(--navy); font-size: 1.4rem; margin-bottom: 1rem; }
    .pravni-obsah h3 { color: var(--navy); font-size: 1rem; letter-spacing: 0.03em; margin-top: 1.6rem; margin-bottom: 0.4rem; }
    .pravni-obsah p { color: #33405c; line-height: 1.6; font-size: 0.95rem; }
    .pravni-zavrit {
      position: absolute; top: 0.7rem; right: 0.7rem; z-index: 1;
      width: 36px; height: 36px; border-radius: 50%; border: none;
      background: var(--red); color: #fff; font-size: 1.3rem; line-height: 1;
      display: flex; align-items: center; justify-content: center; cursor: pointer;
    }
    .pravni-zavrit:hover { background: var(--red-dark); }
    @media (max-width: 560px) {
      .pravni-obsah { padding: 3rem 1.2rem 1.6rem; }
    }
    .site-footer { background: var(--navy-deep); color: var(--cream); padding-top: 3rem; margin-top: 0; }
    .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 2rem; padding-bottom: 2rem; }
    .footer-brand { display: flex; align-items: center; gap: 0.7rem; }
    .footer-brand img { border-radius: 50%; background: var(--cream); }
    .footer-brand strong { font-family: var(--font-display); text-transform: uppercase; color: #fff; }
    .footer-brand small { color: var(--water); }
    .footer-slogan { margin-top: 0.8rem; color: var(--water-pale); max-width: 30ch; }
    .site-footer h4 { font-family: var(--font-display); text-transform: uppercase; color: #fff; font-size: 0.95rem; letter-spacing: 0.08em; margin-bottom: 0.6rem; }
    .site-footer a { color: var(--cream); }
    .site-footer a:hover { color: #fff; }
    .footer-links { display: flex; flex-direction: column; gap: 0.3rem; }
    .footer-bottom { border-top: 1px solid rgba(245, 236, 216, 0.15); padding-block: 1.2rem; font-size: 0.85rem; color: var(--water-pale); }
    @media (max-width: 760px) { .footer-grid { grid-template-columns: 1fr; gap: 1.6rem; } }
  </style>
</body>
</html>
